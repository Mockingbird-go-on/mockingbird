# Mockingbird configuration (environment overrides)
# Copy to .env or export in your shell. Defaults live in
# src/mockingbird/assets/default.yaml

# Data directory (models, db, logs). Default: ~/.mockingbird
# MOCKINGBIRD_HOME=~/.mockingbird

# --- Audio ---
# MOCKINGBIRD_AUDIO_DEVICE=
MOCKINGBIRD_AUDIO_SAMPLE_RATE=16000
MOCKINGBIRD_AUDIO_BLOCK_MS=100
# MOCKINGBIRD_AUDIO_MODE=mic          # mic | loopback (вопросы из системного звука)
# MOCKINGBIRD_AUDIO_LOOPBACK_DEVICE=

# --- VAD (Silero) ---
MOCKINGBIRD_VAD_THRESHOLD=0.5
MOCKINGBIRD_VAD_MIN_SPEECH_MS=250
MOCKINGBIRD_VAD_MIN_SILENCE_MS=700
# MOCKINGBIRD_VAD_MODEL_PATH=

# --- STT backend ---
# MOCKINGBIRD_STT_BACKEND=whisper     # единственный движок: whisper

# --- Whisper (faster-whisper) ---
# Recommended on GTX 1070 (Pascal): large-v3-turbo + float32 (int8_float32 degrades RU WER)
MOCKINGBIRD_WHISPER_MODEL=large-v3-turbo
MOCKINGBIRD_WHISPER_COMPUTE_TYPE=float32
MOCKINGBIRD_WHISPER_BEAM_SIZE=1
MOCKINGBIRD_WHISPER_FINAL_BEAM_SIZE=1
# MOCKINGBIRD_WHISPER_LANGUAGE=ru     # empty = auto-detect
MOCKINGBIRD_WHISPER_WINDOW_SECONDS=3.5
MOCKINGBIRD_WHISPER_PARTIAL_INTERVAL_MS=250
# MOCKINGBIRD_WHISPER_MODEL_DIR=

# --- LLM (OpenAI-compatible): answers + term explanations ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Terms ---
# MOCKINGBIRD_TERMS_LLM_MIN_CHARS=40  # finals shorter skip the LLM (glossary only)
